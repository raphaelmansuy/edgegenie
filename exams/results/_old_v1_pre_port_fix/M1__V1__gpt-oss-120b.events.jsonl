{"type":"text","timestamp":1793935418571,"sessionID":"ses_e511e3907ffeo1J8gcIKAjYZPW","part":{"id":"prt_1aee224b8001XJwpTaB5MwmMBl","messageID":"msg_1aee21466001keqBbdqGyyL8Lz","sessionID":"ses_e511e3907ffeo1J8gcIKAjYZPW","type":"text","text":"**SQL used**\n\n```sql\nCREATE OR REPLACE TABLE workspace.exam_xfde2b.m1_top_zips AS\nWITH base AS (\n  SELECT pickup_zip,\n         COUNT(*) AS trips,\n         SUM(fare_amount) AS total_fare\n  FROM samples.nyctaxi.trips\n  WHERE pickup_zip IS NOT NULL\n  GROUP BY pickup_zip\n  HAVING COUNT(*) >= 200\n),\nhour_counts AS (\n  SELECT pickup_zip,\n         hour(tpep_pickup_datetime) AS hour,\n         COUNT(*) AS cnt\n  FROM samples.nyctaxi.trips\n  WHERE pickup_zip IS NOT NULL\n  GROUP BY pickup_zip, hour(tpep_pickup_datetime)\n),\nb AS (\n  SELECT pickup_zip,\n         hour,\n         cnt,\n         ROW_NUMBER() OVER (PARTITION BY pickup_zip ORDER BY cnt DESC, hour ASC) AS rn\n  FROM hour_counts\n),\njoined AS (\n  SELECT b.pickup_zip,\n         base.trips,\n         ROUND(base.total_fare, 2) AS total_fare,\n         b.hour AS busiest_hour\n  FROM base\n  JOIN b\n    ON base.pickup_zip = b.pickup_zip\n   AND b.rn = 1\n),\nranked AS (\n  SELECT *,\n         DENSE_RANK() OVER (ORDER BY total_fare DESC) AS fare_rank\n  FROM joined\n)\nSELECT pickup_zip,\n       trips,\n       total_fare,\n       fare_rank,\n       ROUND(\n         SUM(total_fare) OVER (ORDER BY total_fare DESC, pickup_zip ASC) /\n         (SELECT SUM(total_fare) FROM ranked) * 100,\n         2) AS cumulative_share_pct,\n       busiest_hour\nFROM ranked\nWHERE fare_rank <= 10\nORDER BY fare_rank;\n```\n\n**Rows created**\n\nThe resulting table `workspace.exam_xfde2b.m1_top_zips` contains **10 rows**.","time":{"start":1793935418553,"end":1793935418556}}}
