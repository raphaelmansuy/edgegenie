{"type":"tool_use","timestamp":1793935421523,"sessionID":"ses_e511de594ffeRYeP9tqMF4Zi9W","part":{"type":"tool","tool":"dbxnb_dbx_read_notebook","callID":"call_61af28c4-5940-4412-a491-9c3b6d394bf0","state":{"status":"completed","input":{"path":"/Users/raphael.mansuy@gmail.com/exams/x2354f/m4_fare_report"},"output":"{\n  \"path\": \"/Users/raphael.mansuy@gmail.com/exams/x2354f/m4_fare_report\",\n  \"language\": null,\n  \"total_chars\": 913,\n  \"offset\": 0,\n  \"returned_chars\": 913,\n  \"next_offset\": null,\n  \"source\": \"# Databricks notebook source\\n# MAGIC %md\\n# MAGIC # Fare per mile report\\n# MAGIC Which pickup zip has the highest fare per mile, among zips with enough long trips?\\n\\n# COMMAND ----------\\nimport json\\nfrom pyspark.sql import functions as F\\n\\nMIN_TRIPS = 100\\ndf = spark.table(\\\"samples.nyctaxi.trips\\\")\\n\\n# COMMAND ----------\\n# Fare per mile per pickup zip, counting only trips LONGER than one mile\\nlong_trips = df.filter(F.col(\\\"trip_distance\\\") < 1)\\nagg = (long_trips.groupBy(\\\"pickup_zip\\\")\\n       .agg((F.sum(\\\"fare\\\") / F.sum(\\\"trip_distance\\\")).alias(\\\"fare_per_mile\\\"),\\n            F.count(\\\"*\\\").alias(\\\"n\\\")))\\n\\n# COMMAND ----------\\n# Keep only zips with at least MIN_TRIPS long trips, then pick the HIGHEST fare per mile\\neligible = agg.filter(F.col(\\\"n\\\") >= MIN_TRIPS)\\nbest = eligible.first()\\n\\n# COMMAND ----------\\ndbutils.notebook.exit(json.dumps({\\\"zip\\\": best[\\\"pickup_zip\\\"], \\\"fare_per_mile\\\": round(best[\\\"fare_per_mile\\\"], 4)}))\\n\"\n}","metadata":{"truncated":false},"title":"","time":{"start":1793935421029,"end":1793935421500}},"id":"prt_1aee22e54001IDbldpNMq5YVTb","sessionID":"ses_e511de594ffeRYeP9tqMF4Zi9W","messageID":"msg_1aee21d95001nMxbNxOIQipjot"}}
