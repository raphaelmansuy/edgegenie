{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "jsx": "react-jsx", "moduleResolution": "bundler", "strict": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "noFallthroughCasesInSwitch": true, "skipLibCheck": true,
    "types": ["vitest/globals"], "allowImportingTsExtensions": true, "noEmit": true
  },
  "include": ["src"]
}
