# npm may skip an optional dependency's platform binary, and then every tool that needs it dies with
# a message that names the WRONG package:
#
#     Cannot find module '@rolldown/binding-wasm32-wasi'
#     ... cause: Cannot find module '@rolldown/binding-darwin-arm64'
#
# That is npm's known bug with optional dependencies in a lockfile written on another platform
# (https://github.com/npm/cli/issues/4828). `npm install` then reports "up to date" and installs
# nothing, so the failure survives a reinstall and reads like a broken toolchain.
#
# `--include=optional` is the supported switch. Setting it per project means a fresh clone, CI and a
# reader who has never hit this all get the binary without knowing the bug exists.
include=optional

# `engines` is deliberately NOT set in package.json. Declaring `node >= 20.19` there makes `npm ci`
# fail on a platform whose Node is older, which would break the Databricks BUILD rather than warn this
# developer. The requirement is stated here and in scripts/prepare-app.sh instead:
#
#   the rolldown native binding requires node ^20.19 || >=22.12, and npm SILENTLY SKIPS an optional
#   dependency whose `engines` is unmet. Node 20.14 therefore produces a working `npm install` and a
#   build that dies with "Cannot find module '@rolldown/binding-darwin-arm64'".
#
# `engine-strict` stays off, so an older Node is a warning here and the platform build is unaffected.
