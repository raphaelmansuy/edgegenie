{
  "$schema": "https://opencode.ai/config.json",
  "model": "dbx/databricks-llama-4-maverick",
  "permission": {
    "bash": "deny",
    "edit": "deny",
    "read": "deny",
    "glob": "deny",
    "grep": "deny",
    "list": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "codesearch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny"
  },
  "provider": {
    "dbx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Databricks serving endpoints",
      "options": {
        "baseURL": "https://h.example.com/serving-endpoints",
        "apiKey": "{env:DATABRICKS_TOKEN}"
      },
      "models": {
        "databricks-llama-4-maverick": {
          "name": "llama-4-maverick",
          "limit": {
            "context": 128000,
            "output": 8000
          }
        }
      }
    }
  }
}
