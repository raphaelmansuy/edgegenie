.env
__pycache__/
*.pyc
.venv/
docs/e2e/.storage_state.json
docs/e2e/screenshots/*.png
!docs/e2e/screenshots/tutorial/*.png
.DS_Store

exams/.tok
exams/.sandbox_id
exams/*.log

# app build artifacts
apps/coding-agent/.venv/
apps/coding-agent/.coverage
apps/coding-agent/.mypy_cache/
apps/coding-agent/*.log
apps/coding-agent/web/node_modules/
apps/coding-agent/web/dist/
# tsc's incremental state: a build artifact that churns on every compile and conflicts on merge.
apps/coding-agent/web/tsconfig.tsbuildinfo
# vitest's json report, written by the test runner
apps/coding-agent/web/.vitest/
apps/coding-agent/web/shots/
__pycache__/
.pytest_cache/
.ruff_cache/
specs/001-databricks-coding-agents/e2e/screenshots/*.png
!specs/001-databricks-coding-agents/e2e/screenshots/*.png

# databricks bundle state
.databricks/

# live credentials - never commit these
.venv2
.env
*.tok

# A FILE named .venv used to hold a plaintext Databricks PAT (someone's shorthand for "credentials
# for this server"). `.venv/` above is a DIRECTORY pattern and does not match a file, so a `git add
# -A` would have committed a live token. Both spellings are ignored now.
.venv

# the site build output: CI rebuilds it, and a committed copy is a second thing to drift
site/dist/

# Site e2e output: regenerated on every run (about 350 PNGs, ~200 MB). CI keeps them as the
# `site-e2e-screenshots` artifact; the reviewed findings live in tests/sites/e2e/visual-inspection.md.
tests/sites/e2e/screenshots/
tests/sites/e2e/report.json

# The build-time install locations. `prepare-app.sh` creates these inside apps/coding-agent, and they
# are large, machine-specific and regenerated: a dependency tree and the agent binary, never source.
apps/coding-agent/node_modules/
apps/coding-agent/.bin/
