+++ b/apps/coding-agent/web/src/styles.css
@@ -2191,7 +2191,22 @@ body:has(.pane.rail.is-drawer) .pane.assistant.is-drawer { width: min(420px, 52v
   flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden;
