diff --git a/apps/coding-agent/web/src/domain/follow.test.ts b/apps/coding-agent/web/src/domain/follow.test.ts
new file mode 100644
index 0000000..316f8f5
--- /dev/null
+++ b/apps/coding-agent/web/src/domain/follow.test.ts
@@ -0,0 +1,74 @@
+import { describe, expect, it } from "vitest";
+import {
+  hasUnseenBelow, INITIAL_FOLLOW, isUpwardKey, onLeave, onScroll, REPIN_PX, type FollowState, type ScrollSample,
+} from "./follow";
+
+const sample = (top: number, extra: Partial<ScrollSample> = {}): ScrollSample => ({
+  top, height: 2000, client: 400, programmatic: false, ...extra,
+});
+const BOTTOM = 1600;
+
+describe("follow — the reader owns the position the moment they move up", () => {
+  it("a small scroll up leaves the tail. The old 80 px dead zone is gone", () => {
+    let s: FollowState = { following: true, lastTop: BOTTOM, lastHeight: 2000 };
+    s = onScroll(s, sample(BOTTOM - 60));
+    expect(s.following).toBe(false);
+  });
+
+  it("our own scroll to the end never counts as the reader leaving", () => {
+    let s: FollowState = { following: true, lastTop: 1000, lastHeight: 2000 };
+    s = onScroll(s, sample(BOTTOM, { programmatic: true }));
+    expect(s.following).toBe(true);
+  });
+
+  it("content growing under a reader who is reading does not re-pin them", () => {
+    let s: FollowState = { following: false, lastTop: 1000, lastHeight: 2000 };
+    // The stream appended: height grew, top is unchanged, no scroll event fires — but if one does:
+    s = onScroll(s, sample(1000, { height: 2600 }));
+    expect(s.following).toBe(false);
+  });
+
+  it("re-pins when the reader returns to the bottom, within REPIN_PX", () => {
+    let s: FollowState = { following: false, lastTop: 1000, lastHeight: 2000 };
+    s = onScroll(s, sample(BOTTOM - REPIN_PX - 1));
+    expect(s.following).toBe(false);
+    s = onScroll(s, sample(BOTTOM - REPIN_PX));
+    expect(s.following).toBe(true);
+  });
+
+  it("moving down while reading does not re-pin until the bottom", () => {
+    let s: FollowState = { following: false, lastTop: 800, lastHeight: 2000 };
+    s = onScroll(s, sample(900));
+    expect(s.following).toBe(false);
+  });
+
+  it("a list that SHRINKS makes the browser clamp scrollTop: that is the content moving, not the reader", () => {
+    // A retry replaced the tail: height fell 2000 -> 1700 and the browser pulled scrollTop down with it.
+    const s = onScroll({ following: true, lastTop: 1600, lastHeight: 2000 }, sample(1300, { height: 1700 }));
+    expect(s.following).toBe(true);
+  });
+});
+
+describe("follow — intent is counted before any scroll event is measured", () => {
+  it("a wheel, touch or key up leaves immediately", () => {
+    expect(onLeave(INITIAL_FOLLOW).following).toBe(false);
+  });
+  it("leaving twice is the same as once, and returns the same object when nothing changes", () => {
+    const left = onLeave(INITIAL_FOLLOW);
+    expect(onLeave(left)).toBe(left);
+  });
+  it("names the keys that go up", () => {
+    for (const key of ["PageUp", "ArrowUp", "Home"]) expect(isUpwardKey({ key })).toBe(true);
+    expect(isUpwardKey({ key: " ", shiftKey: true })).toBe(true);
+    for (const key of ["PageDown", "ArrowDown", "End", "a"]) expect(isUpwardKey({ key })).toBe(false);
+    expect(isUpwardKey({ key: " " })).toBe(false);
+  });
+});
+
+describe("hasUnseenBelow", () => {
+  it("is true only when more than REPIN_PX of content is below the reader", () => {
+    expect(hasUnseenBelow({ top: 0, height: 2000, client: 400 })).toBe(true);
+    expect(hasUnseenBelow({ top: BOTTOM - REPIN_PX, height: 2000, client: 400 })).toBe(false);
+    expect(hasUnseenBelow({ top: BOTTOM, height: 2000, client: 400 })).toBe(false);
+  });
+});
diff --git a/apps/coding-agent/web/src/domain/follow.ts b/apps/coding-agent/web/src/domain/follow.ts
new file mode 100644
index 0000000..040bf00
--- /dev/null
+++ b/apps/coding-agent/web/src/domain/follow.ts
@@ -0,0 +1,65 @@
+/** When a streaming transcript follows its tail, and when it lets the reader go. Pure.
+ *
+ * Two states: FOLLOWING (new content scrolls into view) and READING (the reader's position is theirs).
+ * The old rule was "pinned if within 80 px of the bottom, measured at the last scroll event". That
+ * made the dead zone 80 px wide: one wheel notch or a short trackpad flick moved the reader up by
+ * less than that, they were still "pinned", and the next streamed token took the scroll position
+ * back. From the reader's chair the panel simply would not scroll while it was working.
+ *
+ * The rules, in the order they apply:
+ *  1. **Intent wins.** A wheel up, a touch drag, or an upward key is the reader leaving, and it
+ *     counts before any scroll event has been measured — the stream may append in between.
+ *  2. A scroll that moved UP and was not ours is the reader leaving too (scrollbar drag, anything
+ *     intent did not see).
+ *  3. Following resumes only when the reader is back at the bottom, within `REPIN_PX` — small, and
+ *     deliberately not the old 80.
+ */
+export const REPIN_PX = 24;
+
+export interface FollowState {
+  following: boolean;
+  /** `scrollTop` at the previous scroll event, to tell up from down. */
+  lastTop: number;
+  /** `scrollHeight` at the previous scroll event: a shrinking list makes the browser clamp `scrollTop`
+   *  downwards, and that is the content leaving, not the reader. */
+  lastHeight: number;
+}
+
+export const INITIAL_FOLLOW: FollowState = { following: true, lastTop: 0, lastHeight: 0 };
+
+export interface ScrollSample {
+  top: number;
+  height: number;
+  client: number;
+  /** The scroll was caused by our own `scrollTo`, not by the reader. */
+  programmatic: boolean;
+}
+
+/** A scroll event. */
+export function onScroll(state: FollowState, s: ScrollSample): FollowState {
+  const distance = s.height - s.top - s.client;
+  const clamped = s.height < state.lastHeight;
+  const movedUp = s.top < state.lastTop - 1 && !clamped;
+  let following = state.following;
+  if (!s.programmatic && movedUp) following = false;
+  else if (distance <= REPIN_PX) following = true;
+  return { following, lastTop: s.top, lastHeight: s.height };
+}
+
+/** The reader said "up" with the wheel, a finger, or a key, before the browser reported a scroll. */
+export function onLeave(state: FollowState): FollowState {
+  return state.following ? { ...state, following: false } : state;
+}
+
+/** Keys that move the reader up. `Space` with Shift is a page up. */
+export function isUpwardKey(e: { key: string; shiftKey?: boolean }): boolean {
+  return e.key === "PageUp" || e.key === "ArrowUp" || e.key === "Home" || (e.key === " " && Boolean(e.shiftKey));
+}
+
+/** Should an update to the content move the scroll position? Only while following. */
+export const shouldFollow = (state: FollowState): boolean => state.following;
+
+/** Is there content below the reader that they are not seeing? Drives the "Latest" control. */
+export function hasUnseenBelow(s: Pick<ScrollSample, "top" | "height" | "client">): boolean {
+  return s.height - s.top - s.client > REPIN_PX;
+}
