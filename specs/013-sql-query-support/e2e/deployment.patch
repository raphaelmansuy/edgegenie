diff --git a/apps/coding-agent/api/adapters/databricks/queries.py b/apps/coding-agent/api/adapters/databricks/queries.py
new file mode 100644
index 0000000..6fe6fa3
--- /dev/null
+++ b/apps/coding-agent/api/adapters/databricks/queries.py
@@ -0,0 +1,255 @@
+"""Native Query and Statement adapters share the existing user-authenticated HTTP transport."""
+
+from __future__ import annotations
+
+from ...domain.sqlquery import SqlError, native_id
+from .http import DbxHttp
+
+try:
+    from sqlglot.dialects.databricks import Databricks as SqlDialect
+except ImportError:
+    SqlDialect = None
+
+
+class DatabricksQueries:
+    demo = False
+    dialect = SqlDialect
+
+    def __init__(self, http: DbxHttp, create_enabled=False):
+        self.http, self.create_enabled = http, create_enabled
+
+    async def list(self, actor, cursor, size):
+        data = await self.http.get(
+            "/api/2.0/sql/queries",
+            actor.token,
+            {"page_size": size, **({"page_token": cursor} if cursor else {})},
+        )
+        return {
+            "items": [self.normalize(q, False) for q in data.get("results", [])],
+            "nextCursor": data.get("next_page_token", ""),
+        }
+
+    @staticmethod
+    def normalize(q, content=True):
+        text = q.get("query_text", "")
+        truncated = len(text.encode()) > 200 * 1024
+        if truncated:
+            text = text.encode()[: 200 * 1024].decode("utf-8", "ignore")
+        return {
+            "id": native_id(q["id"]),
+            "name": q.get("display_name") or "Untitled query",
+            "description": q.get("description", "")[:4000],
+            "owner": q.get("owner_user_name", ""),
+            "modifiedAt": q.get("update_time", ""),
+            "warehouseId": q.get("warehouse_id", ""),
+            "catalog": q.get("catalog", ""),
+            "schema": q.get("schema", ""),
+            **(
+                {"text": text, "truncated": truncated, "nativeParameters": q.get("parameters", [])}
+                if content
+                else {}
+            ),
+        }
+
+    async def get(self, actor, query_id):
+        q = await self.http.get(f"/api/2.0/sql/queries/{native_id(query_id)}", actor.token)
+        if q.get("lifecycle_state") == "TRASHED":
+            raise LookupError("Query is unavailable")
+        result = self.normalize(q)
+        # Do not infer CAN RUN from GET. Until effective permission lookup is qualified, fail closed.
+        result["canRun"] = False
+        result["runReason"] = (
+            "Saved-query execution requires a verified native permission mapping. Open in Databricks or author a new independent draft."
+        )
+        return result
+
+    async def create(self, actor, query):
+        if not self.create_enabled:
+            raise SqlError(
+                "CAPABILITY_DISABLED",
+                "Native Query creation has not been qualified for this deployment.",
+                409,
+            )
+        result = await self.http.post(
+            "/api/2.0/sql/queries",
+            actor.token,
+            {
+                "query": {
+                    "display_name": query["name"],
+                    "query_text": query["text"],
+                    "parent_path": query["parent"],
+                    "warehouse_id": query["warehouseId"],
+                    "run_as_mode": "VIEWER",
+                    **({"catalog": query["catalog"]} if query.get("catalog") else {}),
+                    **({"schema": query["schema"]} if query.get("schema") else {}),
+                }
+            },
+        )
+        return self.normalize(result)
+
+    async def warehouses(self, actor):
+        data = await self.http.get("/api/2.0/sql/warehouses", actor.token)
+        return [
+            {"id": w["id"], "name": w.get("name", w["id"]), "state": w.get("state", "UNKNOWN")}
+            for w in data.get("warehouses", [])
+        ]
+
+    async def submit(self, actor, payload):
+        return await self.http.post("/api/2.0/sql/statements", actor.token, payload)
+
+    async def status(self, actor, statement_id):
+        return await self.http.get(f"/api/2.0/sql/statements/{native_id(statement_id)}", actor.token)
+
+    async def cancel(self, actor, statement_id):
+        await self.http.post(f"/api/2.0/sql/statements/{native_id(statement_id)}/cancel", actor.token)
+
+
+class DemoQueries:
+    """Persisted deterministic provider for the local full-stack demo; never touches Databricks."""
+
+    demo = True
+    dialect = SqlDialect
+
+    def __init__(self, store):
+        self.store = store
+
+    async def list(self, actor, cursor, size):
+        await self._seed(actor)
+        rows = await self.store.list(actor.scope, "native", limit=50)
+        offset = int(cursor or 0)
+        return {
+            "items": [{k: v for k, v in q.items() if k != "text"} for q in rows[offset : offset + size]],
+            "nextCursor": str(offset + size) if offset + size < len(rows) else "",
+        }
+
+    async def _seed(self, actor):
+        import time
+
+        seeds = [
+            (
+                "01",
+                "Revenue overview",
+                "A small, reproducible result to explore the SQL workspace.",
+                "SELECT 'North America' AS region, 128400 AS revenue\nUNION ALL SELECT 'Europe', 96350\nUNION ALL SELECT 'Asia Pacific', 78200",
+            ),
+            (
+                "02",
+                "Parameter playground",
+                "Try a typed named parameter without changing the source.",
+                "SELECT :region AS region, 42 AS orders, NULL AS note",
+            ),
+            (
+                "03",
+                "Warehouse health",
+                "A simple query for checking execution and cancellation.",
+                "SELECT 'Connected' AS status, 1 AS warehouse_count",
+            ),
+        ]
+        for suffix, name, description, text in seeds:
+            qid = "00000000-0000-4000-8000-0000000000" + suffix
+            try:
+                await self.store.get(actor.scope, "native", qid)
+            except SqlError:
+                await self.store.put(
+                    actor.scope,
+                    "native",
+                    qid,
+                    {
+                        "id": qid,
+                        "name": name,
+                        "description": description,
+                        "text": text,
+                        "owner": actor.user,
+                        "warehouseId": "demo-warehouse",
+                        "catalog": "",
+                        "schema": "",
+                        "modifiedAt": "2026-11-12T09:30:00Z",
+                        "createdAt": time.time() - int(suffix),
+                        "canRun": True,
+                    },
+                )
+
+    async def get(self, actor, query_id):
+        await self._seed(actor)
+        return await self.store.get(actor.scope, "native", native_id(query_id))
+
+    async def create(self, actor, query):
+        import time
+        from uuid import uuid4
+
+        qid = str(uuid4())
+        return await self.store.put(
+            actor.scope,
+            "native",
+            qid,
+            {
+                **query,
+                "id": qid,
+                "owner": actor.user,
+                "description": "Created in your SQL workspace",
+                "canRun": True,
+                "modifiedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+                "createdAt": time.time(),
+            },
+        )
+
+    async def warehouses(self, actor):
+        return [{"id": "demo-warehouse", "name": "Analytics warehouse", "state": "RUNNING"}]
+
+    async def submit(self, actor, payload):
+        import sqlite3
+        import time
+        from uuid import uuid4
+
+        sid = str(uuid4())
+        try:
+            with sqlite3.connect(":memory:") as db:
+                cursor = db.execute(
+                    payload["statement"], {p["name"]: p["value"] for p in payload.get("parameters", [])}
+                )
+                columns = [{"name": c[0], "type_text": "STRING"} for c in cursor.description or []]
+                rows = [[None if v is None else str(v) for v in row] for row in cursor.fetchmany(1001)]
+            result = {
+                "manifest": {
+                    "schema": {"columns": columns},
+                    "truncated": len(rows) > 1000,
+                    "total_row_count": min(len(rows), 1000),
+                },
+                "result": {"data_array": rows[:1000]},
+            }
+        except sqlite3.Error:
+            result = {
+                "status": {
+                    "state": "FAILED",
+                    "error": {
+                        "message": "The demo engine could not execute this syntax. Use a table-free query; the live provider uses Databricks SQL."
+                    },
+                }
+            }
+        await self.store.put(
+            actor.scope,
+            "statement",
+            sid,
+            {"id": sid, "createdAt": time.time(), "result": result, "canceled": False},
+        )
+        return {"statement_id": sid, "status": {"state": "PENDING"}}
+
+    async def status(self, actor, statement_id):
+        import time
+
+        row = await self.store.get(actor.scope, "statement", statement_id)
+        if row["canceled"]:
+            return {"status": {"state": "CANCELED"}}
+        elapsed = time.time() - row["createdAt"]
+        if elapsed < 3:
+            return {"status": {"state": "PENDING" if elapsed < 1 else "RUNNING"}}
+        return {"status": {"state": "SUCCEEDED"}, **row["result"]}
+
+    async def cancel(self, actor, statement_id):
+        row = await self.store.get(actor.scope, "statement", statement_id)
+        import time
+
+        if time.time() - row["createdAt"] < 3:
+            await self.store.put(
+                actor.scope, "statement", statement_id, {**row, "canceled": True}, row["version"]
+            )
diff --git a/apps/coding-agent/api/adapters/durable/query_sqlite.py b/apps/coding-agent/api/adapters/durable/query_sqlite.py
new file mode 100644
index 0000000..02c6833
--- /dev/null
+++ b/apps/coding-agent/api/adapters/durable/query_sqlite.py
@@ -0,0 +1,197 @@
+"""Encrypted SQL journal, independent of chat. Atomic reservations never replay an external POST."""
+
+from __future__ import annotations
+
+import asyncio
+import fcntl
+import json
+import os
+import sqlite3
+import time
+from pathlib import Path
+
+from cryptography.fernet import Fernet
+
+from ...domain.sqlquery import ACTIVE, SqlError
+
+
+class SqliteQueryStore:
+    def __init__(self, path: str = "", key: str = "", production: bool = False):
+        self.path, self.key, self.production = path, key, production
+        self.durable = bool(path)
+        self._db = None
+        self._owner = None
+        self._lock = asyncio.Lock()
+
+    def open(self):
+        if self._db is not None:
+            return self._db
+        key = self.key.encode()
+        if self.path:
+            path = Path(self.path).expanduser().resolve()
+            path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+            if not key:
+                if self.production:
+                    raise SqlError(
+                        "STORAGE_UNAVAILABLE", "Configure APP_SQL_KEY for encrypted SQL recovery.", 503
+                    )
+                keypath = Path(str(path) + ".key")
+                try:
+                    fd = os.open(keypath, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+                except FileExistsError:
+                    key = keypath.read_bytes()
+                else:
+                    key = Fernet.generate_key()
+                    with os.fdopen(fd, "wb") as stream:
+                        stream.write(key)
+            self._owner = open(str(path) + ".owner", "a+")  # noqa: SIM115 - held until service shutdown
+            os.chmod(self._owner.name, 0o600)
+            try:
+                fcntl.flock(self._owner, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            except BlockingIOError as exc:
+                self._owner.close()
+                self._owner = None
+                raise SqlError(
+                    "STORAGE_UNAVAILABLE", "SQL journal has another server owner; use one worker.", 503
+                ) from exc
+            self._db = sqlite3.connect(path, check_same_thread=False)
+            os.chmod(path, 0o600)
+        else:
+            self._db = sqlite3.connect(":memory:", check_same_thread=False)
+            key = key or Fernet.generate_key()
+        self._cipher = Fernet(key)
+        self._db.execute("PRAGMA synchronous=FULL")
+        self._db.executescript("""
+            CREATE TABLE IF NOT EXISTS sql_item (
+              scope TEXT NOT NULL, kind TEXT NOT NULL, id TEXT NOT NULL, created REAL NOT NULL,
+              version INTEGER NOT NULL, state TEXT NOT NULL, body BLOB NOT NULL,
+              PRIMARY KEY(scope, kind, id));
+            CREATE INDEX IF NOT EXISTS sql_recent ON sql_item(scope,kind,created DESC,id DESC);
+            CREATE INDEX IF NOT EXISTS sql_active ON sql_item(kind,state,scope);
+            CREATE TABLE IF NOT EXISTS sql_operation (
+              scope TEXT NOT NULL, key TEXT NOT NULL, fingerprint TEXT NOT NULL,
+              id TEXT NOT NULL, kind TEXT NOT NULL, created REAL NOT NULL, PRIMARY KEY(scope,key));
+        """)
+        return self._db
+
+    def _encode(self, body):
+        return self._cipher.encrypt(json.dumps(body, ensure_ascii=False).encode())
+
+    def _read(self, scope, kind, key):
+        row = (
+            self.open()
+            .execute("SELECT body FROM sql_item WHERE scope=? AND kind=? AND id=?", (scope, kind, key))
+            .fetchone()
+        )
+        if not row:
+            raise SqlError("NOT_FOUND", "This item is unavailable or no longer accessible.", 404)
+        return json.loads(self._cipher.decrypt(row[0]))
+
+    async def get(self, scope, kind, key):
+        async with self._lock:
+            return self._read(scope, kind, key)
+
+    def _write(self, scope, kind, key, body, expected=None):
+        db = self.open()
+        old = db.execute(
+            "SELECT version FROM sql_item WHERE scope=? AND kind=? AND id=?", (scope, kind, key)
+        ).fetchone()
+        if expected is not None and (not old or old[0] != expected):
+            raise SqlError(
+                "CONFLICT",
+                "This draft or run changed in another request. Reload before applying changes.",
+                409,
+            )
+        body = {**body, "version": (old[0] + 1) if old else 1}
+        db.execute(
+            "INSERT INTO sql_item VALUES (?,?,?,?,?,?,?) ON CONFLICT(scope,kind,id) DO UPDATE SET version=excluded.version,state=excluded.state,body=excluded.body",
+            (
+                scope,
+                kind,
+                key,
+                body["createdAt"],
+                body["version"],
+                body.get("state", ""),
+                self._encode(body),
+            ),
+        )
+        return body
+
+    async def put(self, scope, kind, key, body, expected=None):
+        async with self._lock:
+            with self.open():
+                return self._write(scope, kind, key, body, expected)
+
+    async def list(self, scope, kind, before=0, limit=50):
+        async with self._lock:
+            # This is an explicitly bounded recent window, deterministically ordered by time and ID.
+            rows = (
+                self.open()
+                .execute(
+                    "SELECT body FROM sql_item WHERE scope=? AND kind=? AND created<? ORDER BY created DESC,id DESC LIMIT ?",
+                    (scope, kind, before or time.time() + 1, min(limit, 50)),
+                )
+                .fetchall()
+            )
+            return [json.loads(self._cipher.decrypt(row[0])) for row in rows]
+
+    async def reserve(self, scope, key, fingerprint, body):
+        async with self._lock:
+            db = self.open()
+            with db:
+                old = db.execute(
+                    "SELECT fingerprint,id,kind,created FROM sql_operation WHERE scope=? AND key=?",
+                    (scope, key),
+                ).fetchone()
+                if old:
+                    if old[0] != fingerprint:
+                        raise SqlError("CONFLICT", "This operation key belongs to different input.", 409)
+                    if time.time() - old[3] > 86400:
+                        raise SqlError(
+                            "CONFLICT", "This operation key has expired; it cannot be replayed.", 409
+                        )
+                    return self._read(scope, old[2], old[1]), False
+                kind = body.get("operationKind", "run")
+                if kind == "run":
+                    states = tuple(ACTIVE)
+                    marks = ",".join("?" for _ in states)
+                    count = db.execute(
+                        f"SELECT COUNT(*) FROM sql_item WHERE scope=? AND kind='run' AND state IN ({marks})",
+                        (scope, *states),
+                    ).fetchone()[0]
+                    total = db.execute(
+                        f"SELECT COUNT(*) FROM sql_item WHERE kind='run' AND state IN ({marks})", states
+                    ).fetchone()[0]
+                    if count >= 4 or total >= 32:
+                        raise SqlError(
+                            "RUN_LIMIT",
+                            "Too many active SQL runs. Cancel or resolve an existing run first.",
+                            409,
+                        )
+                    source = body.get("sourceRef", "")
+                    if source:
+                        active = db.execute(
+                            f"SELECT body FROM sql_item WHERE scope=? AND kind='run' AND state IN ({marks})",
+                            (scope, *states),
+                        ).fetchall()
+                        if any(
+                            json.loads(self._cipher.decrypt(row[0])).get("sourceRef") == source
+                            for row in active
+                        ):
+                            raise SqlError(
+                                "RUN_LIMIT", "This query already has an active or unresolved run.", 409
+                            )
+                saved = self._write(scope, kind, body["id"], body)
+                db.execute(
+                    "INSERT INTO sql_operation VALUES (?,?,?,?,?,?)",
+                    (scope, key, fingerprint, body["id"], kind, time.time()),
+                )
+                return saved, True
+
+    def close(self):
+        if self._db is not None:
+            self._db.close()
+            self._db = None
+        if self._owner is not None:
+            self._owner.close()
+            self._owner = None
