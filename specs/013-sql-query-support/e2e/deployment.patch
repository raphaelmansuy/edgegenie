+.sql-save-dialog { width:min(460px,calc(100vw - 32px)); max-height:calc(100dvh - 40px); overflow:auto; padding:28px; background:var(--surface); color:var(--ink); border:1px solid var(--line-strong); border-radius:10px; }
+.sql-save-dialog::backdrop { background:rgba(18,18,24,.35); }
